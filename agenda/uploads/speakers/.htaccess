# Uploaded files are data, never code.
# This is the most important file in the module — without it an upload
# bug becomes a shell.
#
# NOTE: `php_flag` only exists under mod_php. Hostinger runs LiteSpeed with
# PHP-FPM, where an unguarded php_flag throws a 500. It is wrapped below so
# the file is safe on both stacks.

<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>

# The guard that actually does the work on LiteSpeed / PHP-FPM.
<FilesMatch "\.(php|php[0-9]|phtml|phps|phar|cgi|pl|py|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Belt and braces: strip any handler that would execute a file here.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
